APP_NAME="Padu Kue"
APP_ENV=production
APP_KEY=base64:GENERATE_KEY_DENGAN_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://padukue.store

# Port binding di host VPS (default 8080)
APP_PORT=8080

# Otomatis migrate saat container nyala (true/false)
AUTORUN_MIGRATIONS=true

# Otomatis jalankan background queue worker di container (true/false)
AUTORUN_QUEUE_WORKER=false

# Database PostgreSQL (Nama container / service db di ai_network atau IP server)
DB_CONNECTION=pgsql
DB_HOST=postgres_container_name_or_ip
DB_PORT=5432
DB_DATABASE=padukue_prod
DB_USERNAME=padukue_user
DB_PASSWORD=your_secure_db_password

# Session & Cache (Bisa gunakan database atau redis yang ada di server)
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis (Jika menggunakan Redis yang sudah ada di ai_network)
REDIS_CLIENT=predis
REDIS_HOST=redis_container_name_or_ip
REDIS_PASSWORD=null
REDIS_PORT=6379

# Object Storage S3 / MinIO (Sudah ada di server)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=your_minio_or_s3_key
AWS_SECRET_ACCESS_KEY=your_minio_or_s3_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=padukue-storage
AWS_ENDPOINT=http://minio_container_name_or_ip:9000
AWS_URL=https://s3.yourdomain.com/padukue-storage
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_THROW=true

# Path Headless Chromium untuk PDF Invoice (Spatie Browsershot)
CHROME_PATH=/usr/bin/chromium-browser
